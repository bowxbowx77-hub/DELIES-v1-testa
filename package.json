{
  "name": "devvault-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 scripts/dev.py",
    "dev:ui": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "start": "python3 scripts/serve.py",
    "test": "python3 scripts/test.py",
    "test:e2e": "npm run build && playwright test",
    "format": "prettier --write web tests/browser *.ts *.json index.html",
    "setup:server": "python3 scripts/setup_backend.py",
    "predev": "npm run setup:server",
    "pretest": "npm run setup:server",
    "prestart": "npm run setup:server"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "lucide-react": "0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "^3.10.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.0"
  },
  "engines": {
    "node": ">=22"
  }
}
